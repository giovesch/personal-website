---
interface Props {
  title: string;
  description: string;
  link: string;
  isExternal?: boolean;
}

const {
  title,
  description,
  link,
  isExternal = true,
} = Astro.props;
---

<a 
  href={link} 
  class="project-card" 
  target={isExternal ? "_blank" : undefined}
  rel={isExternal ? "noopener noreferrer" : undefined}
>
  <div class="project-title">{title}</div>
  <p class="project-desc">{description}</p>
</a>
