---
import BaseLayout from "../layouts/BaseLayout.astro";
import ProjectCard from "../components/ProjectCard.astro";
import { getCollection } from "astro:content";

const allPosts = await getCollection("blog");
const sortedPosts = allPosts.sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
const recentPosts = sortedPosts.slice(0, 3);

const highlightedProjects = [
  {
    title: "giove-cms",
    badge: "Open Source",
    description:
      "A code-first headless CMS engineered for autonomous AI agents and human editors alike: typed collections, draft revisions, and WebMCP integration.",
    link: "https://github.com/giovesch/giove-cms",
    tags: ["TypeScript", "WebMCP", "Astro", "Agentic UI"],
    isExternal: true,
  },
  {
    title: "Ising Phase Simulator",
    badge: "Physics",
    description:
      "Monte Carlo Metropolis-Hastings and Wolff cluster simulation of 2D ferromagnetic spin lattices with real-time thermodynamic state metrics.",
    link: "/blog/simulating-ferromagnetic-phase-transitions",
    tags: ["Python", "NumPy", "Statistical Mechanics", "MCMC"],
    isExternal: false,
  },
  {
    title: "omacool",
    badge: "Systems",
    description:
      "Hardware thermal and fan management utility for Linux hwmon interfaces, featuring custom curve editing and thermal zone orchestration.",
    link: "https://github.com/giovesch/omacool",
    tags: ["Linux", "hwmon", "C++", "Kernel Interfaces"],
    isExternal: true,
  },
  {
    title: "Punto",
    badge: "Computer Vision",
    description:
      "Offline skin-mapping and spatial relocalization system using ORB feature keyframes and an encrypted local SQLite/SQLCipher vault.",
    link: "https://github.com/giovesch/punto",
    tags: ["Computer Vision", "ORB-SLAM", "C++", "Security"],
    isExternal: true,
  },
];
---

<BaseLayout
  title="Giovanni Schiavo — Physics Student & Developer"
  description="Personal website and notebook of Giovanni Schiavo: physics student at the University of Padova, developer and tech enthusiast."
>
  <div class="container">
    <!-- WHO AM I SECTION -->
    <section class="hero" id="who-am-i">
      <h1 class="hero-name">Giovanni Schiavo</h1>
      <p class="hero-subtitle">
        Physics student at University of Padova · Developer &amp; tech enthusiast
      </p>

      <div class="status-pills">
        <span class="status-pill">
          <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M22 10v6M2 10l10-5 10 5-10 5z"></path>
            <path d="M6 12v5c3 3 9 3 12 0v-5"></path>
          </svg>
          UniPD Physics
        </span>
        <span class="status-pill">
          <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"></path>
            <circle cx="12" cy="10" r="3"></circle>
          </svg>
          Padova, Italy
        </span>
        <span class="status-pill">
          <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="16 18 22 12 16 6"></polyline>
            <polyline points="8 6 2 12 8 18"></polyline>
          </svg>
          Full-Stack &amp; Systems
        </span>
      </div>

      <div class="hero-bio">
        <p>
          I am an undergraduate physics student at the <span class="highlight-text">University of Padova</span>, where I explore the mathematical and computational principles governing complex physical systems — from statistical mechanics to numerical simulations.
        </p>
        <p>
          Beyond physics, I am a dedicated <span class="highlight-text">software developer</span> fascinated by elegant systems, developer tools, and agentic workflows. When I am away from my terminal, you will find me experimenting with <span class="highlight-text">sourdough fermentation and cooking</span>, walking the historic porticoes of Padova with a camera for <span class="highlight-text">street photography</span>, or studying portfolio theory and <span class="highlight-text">personal finance</span>.
        </p>
      </div>

      <div class="social-links">
        <a href="https://github.com/giovesch" target="_blank" rel="noopener noreferrer" class="social-btn">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"></path>
            <path d="M9 18c-4.51 2-5-2-7-2"></path>
          </svg>
          GitHub
        </a>
        <a href="mailto:giovanni@schiavo.me" class="social-btn">
          <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect width="20" height="16" x="2" y="4" rx="2"></rect>
            <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
          </svg>
          Email
        </a>
        <a href="/blog" class="social-btn">
          <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"></path>
            <path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"></path>
          </svg>
          Read Blog
        </a>
      </div>
    </section>

    <!-- HIGHLIGHTED PROJECTS SECTION -->
    <section class="section" id="projects">
      <div class="section-header">
        <h2 class="section-title">Highlighted Projects</h2>
        <a href="/projects" class="section-link">
          view all
          <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="m9 18 6-6-6-6"></path>
          </svg>
        </a>
      </div>

      <div class="projects-grid">
        {highlightedProjects.map((project) => (
          <ProjectCard
            title={project.title}
            badge={project.badge}
            description={project.description}
            link={project.link}
            tags={project.tags}
            isExternal={project.isExternal}
          />
        ))}
      </div>
    </section>

    <!-- SINGLE THREAD STYLE BLOG / RECENT ARTICLES -->
    <section class="section" id="blog-thread">
      <div class="section-header">
        <h2 class="section-title">Writing &amp; Notes</h2>
        <a href="/blog" class="section-link">
          enter thread
          <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="m9 18 6-6-6-6"></path>
          </svg>
        </a>
      </div>

      <div class="thread-container">
        {recentPosts.map((post) => (
          <article class="thread-entry">
            <div class="thread-meta">
              <time class="thread-date" datetime={post.data.pubDate.toISOString()}>
                {post.data.pubDate.toLocaleDateString("en-US", {
                  year: "numeric",
                  month: "short",
                  day: "numeric",
                })}
              </time>
              <span>·</span>
              <span>{post.data.readingTime}</span>
            </div>

            <h3 class="thread-title">
              <a href={`/blog/${post.id}`}>{post.data.title}</a>
            </h3>

            <p class="thread-summary">{post.data.description}</p>

            <div class="thread-actions">
              <a href={`/blog/${post.id}`} class="thread-read-link">
                Read article &rarr;
              </a>
              <div class="tag-list">
                {post.data.tags.map((tag) => (
                  <span class="blog-tag">#{tag}</span>
                ))}
              </div>
            </div>
          </article>
        ))}
      </div>
    </section>
  </div>
</BaseLayout>
