---
import BaseLayout from "../layouts/BaseLayout.astro";
import ProjectCard from "../components/ProjectCard.astro";

const projects = [
  {
    title: "giove-cms",
    description:
      "A code-first headless CMS engineered for autonomous AI agents and human editors alike: typed collections, draft revisions, and WebMCP tooling.",
    link: "https://github.com/giovesch/giove-cms",
    isExternal: true,
  },
  {
    title: "Ising Phase Simulator",
    description:
      "Monte Carlo simulation of 2D ferromagnetic spin lattices comparing Metropolis-Hastings vs. Wolff cluster algorithms across critical temperatures.",
    link: "/blog#simulating-ferromagnetic-phase-transitions",
    isExternal: false,
  },
  {
    title: "omacool",
    description:
      "Linux hwmon fan control utility with live thermal monitoring, preset profiles, and a curve editor for thermal orchestration.",
    link: "https://github.com/giovesch/omacool",
    isExternal: true,
  },
  {
    title: "Punto",
    description:
      "Offline skin-mapping and spatial relocalization system using ORB feature keyframes and an encrypted local SQLite/SQLCipher vault.",
    link: "https://github.com/giovesch/punto",
    isExternal: true,
  },
  {
    title: "dotfiles",
    description:
      "Cross-platform configuration environment tailored for high keyboard-driven productivity across Linux and macOS.",
    link: "https://github.com/giovesch/dotfiles",
    isExternal: true,
  },
  {
    title: "LedgerFlow Portfolio Engine",
    description:
      "Modern portfolio theory asset allocator and rebalancing calculator implementing Markowitz mean-variance optimization.",
    link: "/blog#a-physicists-guide-to-personal-finance",
    isExternal: false,
  },
  {
    title: "Giove's Culinary Notebook",
    description:
      "Formulations, hydration tables, and fermentation kinetics for high-hydration sourdough baking and culinary physics.",
    link: "/blog#science-of-78-percent-hydration-sourdough",
    isExternal: false,
  },
];
---

<BaseLayout
  title="Giovanni Schiavo"
  description="Personal website of Giovanni Schiavo: physics student at the University of Padova, developer and tech enthusiast."
>
  <div class="container">
    <!-- WHO AM I -->
    <section class="hero" id="who-am-i">
      <h1 class="hero-name">Giovanni Schiavo</h1>
      <p class="hero-subtitle">
        Physics student at University of Padova &middot; Developer
      </p>

      <div class="hero-bio">
        <p>
          Undergraduate physics student in Padova exploring statistical mechanics, computational models, and simulation algorithms. Software developer focused on clean systems, tooling, and agentic workflows.
        </p>
        <p>
          Outside the terminal: high-hydration sourdough fermentation, street photography with a 35mm prime under Padova's porticoes, and portfolio theory.
        </p>
      </div>

      <nav class="hero-links" aria-label="Social and page links">
        <a href="https://github.com/giovesch" target="_blank" rel="noopener noreferrer">github</a>
        <span class="sep">/</span>
        <a href="mailto:contact@giovannischiavo.com">contact</a>
        <span class="sep">/</span>
        <a href="/blog">blog</a>
      </nav>
    </section>

    <!-- PROJECTS -->
    <section class="section" id="projects" style="margin-bottom: 1rem;">
      <div class="section-header">
        <h2 class="section-title">Projects</h2>
      </div>

      <div class="projects-grid">
        {projects.map((project) => (
          <ProjectCard
            title={project.title}
            description={project.description}
            link={project.link}
            isExternal={project.isExternal}
          />
        ))}
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .hero-links {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-size: 0.9rem;
    font-family: var(--font-mono);
  }

  .hero-links a {
    color: var(--text-muted);
    transition: color 0.15s ease;
  }

  .hero-links a:hover {
    color: var(--text-main);
  }

  .sep {
    color: var(--border-color);
    user-select: none;
  }
</style>
