---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";

const allPosts = await getCollection("blog");
// Sorted chronologically by posting date (newest first)
const sortedPosts = allPosts.sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const renderedArticles = await Promise.all(
  sortedPosts.map(async (post) => {
    const { Content } = await render(post);
    return {
      post,
      Content,
      formattedDate: post.data.pubDate.toLocaleDateString("en-US", {
        year: "numeric",
        month: "short",
        day: "numeric",
      }),
    };
  })
);
---

<BaseLayout
  title="Writing — Giovanni Schiavo"
  description="All articles and technical notes by Giovanni Schiavo in full chronological order."
>
  <div class="container" style="max-width: 680px;">
    <!-- Top Nav -->
    <div style="margin-bottom: 2.5rem;">
      <a href="/" class="back-link">&larr; giovanni schiavo</a>
    </div>

    <!-- Page Header -->
    <header class="feed-header">
      <h1 class="hero-name" style="margin-bottom: 0.5rem;">Writing</h1>
      <p style="color: var(--text-muted); font-size: 0.95rem;">
        All articles and notes loaded in full, in order of posting.
      </p>

      <!-- Minimal Table of Contents -->
      <nav class="jump-nav" aria-label="Jump to article">
        <span class="jump-label">Index:</span>
        <div class="jump-links">
          {renderedArticles.map(({ post }) => (
            <a href={`#${post.id}`}>{post.data.title}</a>
          ))}
        </div>
      </nav>
    </header>

    <!-- Articles Stream -->
    <div class="articles-stream">
      {renderedArticles.map(({ post, Content, formattedDate }, idx) => (
        <article class="single-article" id={post.id}>
          <header class="article-header">
            <div class="article-meta">
              <time datetime={post.data.pubDate.toISOString()}>{formattedDate}</time>
              <span>&middot;</span>
              <span>{post.data.readingTime}</span>
              <a href={`#${post.id}`} class="anchor-link" aria-label={`Permalink to ${post.data.title}`}>#</a>
            </div>

            <h2 class="article-title">
              <a href={`#${post.id}`}>{post.data.title}</a>
            </h2>

            {post.data.tags.length > 0 && (
              <div class="article-tags">
                {post.data.tags.map((tag) => (
                  <span class="tag">#{tag}</span>
                ))}
              </div>
            )}
          </header>

          <div class="prose">
            <Content />
          </div>

          <div class="article-bottom">
            <a href="#" onclick="window.scrollTo({top: 0, behavior: 'smooth'}); return false;" class="top-link">
              &uarr; top
            </a>
          </div>

          {idx < renderedArticles.length - 1 && <hr class="article-divider" />}
        </article>
      ))}
    </div>
  </div>
</BaseLayout>

<style>
  .back-link {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--text-muted);
  }

  .back-link:hover {
    color: var(--text-main);
  }

  .feed-header {
    margin-bottom: 3.5rem;
    padding-bottom: 2rem;
    border-bottom: 1px solid var(--border-color);
  }

  .jump-nav {
    margin-top: 1.5rem;
    font-size: 0.85rem;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .jump-label {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--text-faint);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .jump-links {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .jump-links a {
    color: var(--text-muted);
  }

  .jump-links a:hover {
    color: var(--text-main);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .articles-stream {
    display: flex;
    flex-direction: column;
  }

  .single-article {
    scroll-margin-top: 2rem;
  }

  .article-header {
    margin-bottom: 1.75rem;
  }

  .article-meta {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.825rem;
    font-family: var(--font-mono);
    color: var(--text-faint);
    margin-bottom: 0.5rem;
  }

  .anchor-link {
    margin-left: auto;
    color: var(--text-faint);
  }

  .anchor-link:hover {
    color: var(--text-main);
  }

  .article-title {
    font-family: var(--font-serif);
    font-size: 1.95rem;
    line-height: 1.25;
    font-weight: 500;
    margin-bottom: 0.6rem;
  }

  .article-title a {
    color: var(--text-main);
  }

  .article-title a:hover {
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .article-tags {
    display: flex;
    gap: 0.4rem;
    flex-wrap: wrap;
    margin-top: 0.5rem;
  }

  .tag {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--text-faint);
  }

  .article-bottom {
    margin-top: 2.5rem;
    display: flex;
    justify-content: flex-end;
  }

  .top-link {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--text-faint);
  }

  .top-link:hover {
    color: var(--text-muted);
  }

  .article-divider {
    border: none;
    border-top: 1px solid var(--border-color);
    margin: 4rem 0;
  }
</style>
